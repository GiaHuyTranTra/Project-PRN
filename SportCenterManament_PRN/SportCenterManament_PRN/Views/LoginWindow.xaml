<Window x:Class="SportCenterManament_PRN.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Quản lý Trung tâm Thể thao" 
        Height="540" 
        Width="460" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFFFFF" 
                CornerRadius="12" 
                Margin="30,25,30,25" 
                Padding="32,28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
            </Border.Effect>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SPORTS CENTER" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1E40AF" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,4"/>

                <TextBlock Text="Hệ thống Quản lý Trung tâm Thể thao" 
                           FontSize="13" 
                           Foreground="#6B7280" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,24"/>

                <TextBlock Text="Địa chỉ Email" 
                           FontSize="13" 
                           FontWeight="Medium" 
                           Foreground="#374151" 
                           Margin="0,0,0,6"/>
                <TextBox x:Name="txtEmail" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,16"/>

                <TextBlock Text="Mật khẩu" 
                           FontSize="13" 
                           FontWeight="Medium" 
                           Foreground="#374151" 
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" 
                             Style="{StaticResource ModernPasswordBox}" 
                             Margin="0,0,0,12"/>

                <Border x:Name="bdrError" 
                        Background="#FEE2E2" 
                        BorderBrush="#F87171" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="8,6" 
                        Margin="0,0,0,14" 
                        Visibility="Collapsed">
                    <TextBlock x:Name="lblErrorMessage" 
                               Foreground="#B91C1C" 
                               FontSize="12" 
                               TextWrapping="Wrap"/>
                </Border>

                <ProgressBar x:Name="prgLoading" 
                             Height="4" 
                             IsIndeterminate="True" 
                             Foreground="#2563EB" 
                             Margin="0,0,0,12" 
                             Visibility="Collapsed"/>

                <Button x:Name="btnLogin" 
                        Content="Đăng nhập" 
                        IsDefault="True" 
                        Style="{StaticResource ModernButton}" 
                        Click="btnLogin_Click" 
                        Margin="0,4,0,10"/>

                <Button x:Name="btnOpenRegister" 
                        Content="Chưa có tài khoản? Đăng ký ngay" 
                        Background="Transparent" 
                        Foreground="#2563EB" 
                        BorderThickness="0" 
                        FontSize="13" 
                        Cursor="Hand" 
                        Click="btnOpenRegister_Click" 
                        HorizontalAlignment="Center" 
                        Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
