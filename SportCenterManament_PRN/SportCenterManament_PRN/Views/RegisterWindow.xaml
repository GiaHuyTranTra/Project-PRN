<Window x:Class="SportCenterManament_PRN.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký tài khoản - Sports Center" 
        Height="680" 
        Width="500" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Border Background="#FFFFFF" 
                    CornerRadius="12" 
                    Margin="30,20,30,20" 
                    Padding="30,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                </Border.Effect>
                
                <StackPanel>
                    <TextBlock Text="TẠO TÀI KHOẢN MỚI" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#1E40AF" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Đăng ký tài khoản hệ thống Sports Center" 
                               FontSize="12" 
                               Foreground="#6B7280" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Username (Tên người dùng)" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtUsername" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Họ và tên" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtFullName" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Địa chỉ Email" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEmail" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Mật khẩu" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtPassword" 
                                 Style="{StaticResource ModernPasswordBox}" 
                                 Margin="0,0,0,10"/>

                    <TextBlock Text="Xác nhận Mật khẩu" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtConfirmPassword" 
                                 Style="{StaticResource ModernPasswordBox}" 
                                 Margin="0,0,0,10"/>

                    <TextBlock Text="Số điện thoại" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPhone" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Vai trò (Role)" 
                               FontSize="12" 
                               FontWeight="Medium" 
                               Foreground="#374151" 
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboRole" 
                              Height="34" 
                              FontSize="13" 
                              Margin="0,0,0,14" 
                              SelectedIndex="0">
                        <ComboBoxItem Content="Hội viên / Khách hàng (Member / Customer)" Tag="3"/>
                        <ComboBoxItem Content="Huấn luyện viên (Coach)" Tag="2"/>
                        <ComboBoxItem Content="Quản lý trung tâm (CenterManager)" Tag="1"/>
                    </ComboBox>

                    <Border x:Name="bdrMessage" 
                            Background="#FEE2E2" 
                            BorderBrush="#F87171" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,6" 
                            Margin="0,0,0,10" 
                            Visibility="Collapsed">
                        <TextBlock x:Name="lblMessage" 
                                   Foreground="#B91C1C" 
                                   FontSize="12" 
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ProgressBar x:Name="prgLoading" 
                                 Height="4" 
                                 IsIndeterminate="True" 
                                 Foreground="#2563EB" 
                                 Margin="0,0,0,10" 
                                 Visibility="Collapsed"/>

                    <Button x:Name="btnRegister" 
                            Content="Đăng ký tài khoản" 
                            Style="{StaticResource PrimaryButton}" 
                            Click="btnRegister_Click" 
                            Margin="0,2,0,8"/>

                    <Button x:Name="btnBackToLogin" 
                            Content="Đã có tài khoản? Quay lại Đăng nhập" 
                            Background="Transparent" 
                            Foreground="#2563EB" 
                            BorderThickness="0" 
                            FontSize="12" 
                            Cursor="Hand" 
                            Click="btnBackToLogin_Click" 
                            HorizontalAlignment="Center" 
                            Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
