<Window x:Class="SportCenterManament_PRN.Views.AssignCoachDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phân công huấn luyện viên"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="PHÂN CÔNG COACH"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E40AF"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Lớp học"/>

            <TextBlock x:Name="txtClassName"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0,3,0,12"/>

            <TextBlock Text="Huấn luyện viên"/>

            <ComboBox x:Name="cbCoach"
                      Height="32"
                      Margin="0,4,0,12"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <TextBlock Text="Phòng tập"/>

            <ComboBox x:Name="cbRoom"
                      Height="32"
                      Margin="0,4,0,12"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <TextBlock Text="Ngày học"/>

            <DatePicker x:Name="dpDate"
                        Height="32"
                        Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bắt đầu (HH:mm)"/>

                    <TextBox x:Name="txtStart"
                             Text="08:00"
                             Height="32"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kết thúc (HH:mm)"/>

                    <TextBox x:Name="txtEnd"
                             Text="09:00"
                             Height="32"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Sức chứa buổi học"/>

            <TextBox x:Name="txtCapacity"
                     Height="32"
                     Margin="0,4,0,12"/>

            <TextBlock Text="Ghi chú"/>

            <TextBox x:Name="txtNotes"
                     Height="32"
                     Margin="0,4,0,14"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="btnSave"
                        Content="Lưu phân công"
                        Width="130"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="btnSave_Click"/>

                <Button Content="Hủy"
                        Width="85"
                        Height="34"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
