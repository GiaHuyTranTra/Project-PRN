<Window x:Class="SportCenterManament_PRN.Views.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điểm danh học viên" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ĐIỂM DANH HỌC VIÊN" FontSize="24"
                       FontWeight="Bold" Foreground="#1F2937"/>
            <TextBlock Text="Chọn ngày và buổi học, sau đó cập nhật trạng thái có mặt của từng học viên."
                       Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ngày học:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpSessionDate" Grid.Column="1"
                            SelectedDateChanged="dpSessionDate_SelectedDateChanged"/>
                <TextBlock Grid.Column="2" Text="Buổi học:" VerticalAlignment="Center"
                           Margin="18,0,10,0"/>
                <ComboBox x:Name="cbSessions" Grid.Column="3"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="cbSessions_SelectionChanged" MinWidth="250"/>
                <Button Grid.Column="4" Content="Tải danh sách" Padding="16,7"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        Click="btnLoad_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgAttendance" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#E5E7EB" BorderThickness="1" RowHeight="42"
                  Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã hội viên" Binding="{Binding MemberCode}"
                                    IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding MemberName}"
                                    IsReadOnly="True" Width="*"/>
                <DataGridCheckBoxColumn Header="Có mặt"
                    Binding="{Binding IsPresent, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Ghi chú"
                    Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Foreground="#6B7280"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Báo cáo chuyên cần" Padding="16,9" Margin="0,0,10,0"
                        Background="#E5E7EB" BorderThickness="0" Click="btnReport_Click"/>
                <Button Content="Lưu điểm danh" Padding="20,9"
                        Background="#059669" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Click="btnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
