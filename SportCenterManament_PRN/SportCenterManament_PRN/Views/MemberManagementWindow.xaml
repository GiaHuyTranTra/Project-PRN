<Window x:Class="SportCenterManament_PRN.Views.MemberManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hội viên"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="QUẢN LÝ HỘI VIÊN"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>
            <TextBlock Text="Danh sách, tìm kiếm và phân trang hội viên"
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch"
                         Grid.Column="0"
                         Height="36"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         ToolTip="Tìm theo mã, họ tên, email hoặc số điện thoại"
                         KeyDown="txtSearch_KeyDown"/>

                <ComboBox x:Name="cboStatus"
                          Grid.Column="1"
                          Height="36"
                          Margin="10,0,0,0"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Tất cả trạng thái" Tag="All"/>
                    <ComboBoxItem Content="Đang hoạt động" Tag="Active"/>
                    <ComboBoxItem Content="Không hoạt động" Tag="Inactive"/>
                </ComboBox>

                <Button x:Name="btnSearch"
                        Grid.Column="2"
                        Content="Tìm kiếm"
                        Height="36"
                        MinWidth="95"
                        Margin="10,0,0,0"
                        Padding="12,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnSearch_Click"/>

                <Button x:Name="btnReload"
                        Grid.Column="3"
                        Content="Tải lại"
                        Height="36"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Padding="12,0"
                        Background="#E5E7EB"
                        Foreground="#1F2937"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnReload_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DataGrid x:Name="dgMembers"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      ColumnHeaderHeight="42"
                      Background="White"
                      BorderThickness="0"
                      SelectionChanged="dgMembers_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã hội viên"
                                        Binding="{Binding MemberCode}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Họ và tên"
                                        Binding="{Binding FullName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="Điện thoại"
                                        Binding="{Binding Phone}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtResultInfo"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="12"
                       Text="Chưa tải dữ liệu"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="btnPrevious"
                        Content="Trước"
                        MinWidth="75"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="btnPrevious_Click"
                        IsEnabled="False"/>
                <TextBlock x:Name="txtPageInfo"
                           VerticalAlignment="Center"
                           MinWidth="90"
                           TextAlignment="Center"
                           Foreground="#374151"/>
                <Button x:Name="btnNext"
                        Content="Tiếp"
                        MinWidth="75"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="btnNext_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
