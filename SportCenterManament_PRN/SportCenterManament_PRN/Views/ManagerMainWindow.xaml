<Window x:Class="SportCenterManament_PRN.Views.ManagerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportCenterManament_PRN.Views"
        mc:Ignorable="d"
        Title="Sport Center - Manager"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Background="#F4F6F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1E293B"
                Padding="20,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">

                    <TextBlock Text="SPORT CENTER MANAGEMENT"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="Manager Dashboard"
                               Foreground="#CBD5E1"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Margin="0,0,20,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="txtFullName"
                                   Text="Manager"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"/>

                        <TextBlock x:Name="txtRole"
                                   Text="CenterManager"
                                   Foreground="#CBD5E1"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <Button x:Name="btnLogout"
                            Content="Đăng xuất"
                            Width="100"
                            Height="35"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="12,20">

                    <TextBlock Text="QUẢN LÝ HỆ THỐNG"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="10,0,0,20"/>

                    <Button x:Name="btnCourseManagement"
                            Content="Quản lý lớp học"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="btnCourseManagement_Click"/>
                    <Button x:Name="btnCoachManagement"
        Content="Quản lý Coach"
        Height="45"
        Margin="0,0,0,10"
        Background="#2563EB"
        Foreground="White"
        BorderThickness="0"
        FontSize="14"
        Cursor="Hand"
        Click="btnCoachManagement_Click"/>

                    <Button x:Name="btnAttendance"
                            Content="Điểm danh học viên"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="btnAttendance_Click"/>

                    <Button x:Name="btnFeedback"
                            Content="Đánh giá &amp; phản hồi"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="btnFeedback_Click"/>
                    

                </StackPanel>
            </Border>

            <!-- PAGE CONTENT -->
            <Border Grid.Column="1"
                    Margin="15"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <ContentControl x:Name="mainContent"/>

            </Border>
        </Grid>
    </Grid>
</Window>
