<Window x:Class="SportCenterManament_PRN.Views.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh giá &amp; phản hồi"
        Height="720"
        Width="1120"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTitle"
                       Text="ĐÁNH GIÁ &amp; PHẢN HỒI"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E40AF"/>
            <TextBlock x:Name="txtSubtitle"
                       Text="Gửi đánh giá sau buổi học đã được điểm danh có mặt."
                       Margin="0,4,0,0"
                       Foreground="#64748B"/>
        </StackPanel>

        <Grid x:Name="MemberPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16" Margin="0,0,0,12"
                    Background="White" BorderBrush="#DCE3EB" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                        <TextBlock Text="Buổi học đã tham gia" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbSessions" Height="32" DisplayMemberPath="Label"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                        <TextBlock Text="Số sao" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbRating" Width="120" Height="32" SelectedIndex="4">
                            <ComboBoxItem Content="1 sao" Tag="1"/>
                            <ComboBoxItem Content="2 sao" Tag="2"/>
                            <ComboBoxItem Content="3 sao" Tag="3"/>
                            <ComboBoxItem Content="4 sao" Tag="4"/>
                            <ComboBoxItem Content="5 sao" Tag="5"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="2" Content="Gửi đánh giá"
                            Width="130" Height="32" Margin="0,22,0,10"
                            Background="#2563EB" Foreground="White"
                            Click="btnSubmit_Click"/>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                        <TextBlock Text="Nhận xét (tối đa 1000 ký tự)" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtComment" Height="72" MaxLength="1000"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <TextBlock x:Name="txtMemberStatus" Grid.Row="2" Grid.ColumnSpan="3"
                               Margin="0,8,0,0" Foreground="#475569" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <GroupBox Grid.Row="1" Header="Đánh giá của tôi" Padding="8" Background="White">
                <DataGrid x:Name="dgMyFeedback" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="2*"/>
                        <DataGridTextColumn Header="Coach" Binding="{Binding CoachName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Sao" Binding="{Binding Rating}" Width="60"/>
                        <DataGridTextColumn Header="Nhận xét" Binding="{Binding Comment}" Width="3*"/>
                        <DataGridTextColumn Header="Ngày gửi" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid x:Name="SummaryPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Lọc nhận xét theo số sao:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cbRatingFilter" Width="150" Height="30"
                          SelectionChanged="cbRatingFilter_SelectionChanged">
                    <ComboBoxItem Content="Tất cả" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="1 sao" Tag="1"/>
                    <ComboBoxItem Content="2 sao" Tag="2"/>
                    <ComboBoxItem Content="3 sao" Tag="3"/>
                    <ComboBoxItem Content="4 sao" Tag="4"/>
                    <ComboBoxItem Content="5 sao" Tag="5"/>
                </ComboBox>
                <TextBlock x:Name="txtSummaryStatus" DockPanel.Dock="Right"
                           VerticalAlignment="Center" Foreground="#475569"/>
            </DockPanel>

            <GroupBox Grid.Row="1" Header="Điểm trung bình theo lớp và Coach" Padding="6" Background="White" Margin="0,0,0,10">
                <DataGrid x:Name="dgAverages" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="2*"/>
                        <DataGridTextColumn Header="Coach" Binding="{Binding CoachName}" Width="2*"/>
                        <DataGridTextColumn Header="Số đánh giá" Binding="{Binding FeedbackCount}" Width="120"/>
                        <DataGridTextColumn Header="Điểm TB" Binding="{Binding AverageRating, StringFormat=F2}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Danh sách phản hồi" Padding="6" Background="White">
                <DataGrid x:Name="dgFeedback" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Coach" Binding="{Binding CoachName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Hội viên" Binding="{Binding MemberName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Sao" Binding="{Binding Rating}" Width="60"/>
                        <DataGridTextColumn Header="Nhận xét" Binding="{Binding Comment}" Width="3*"/>
                        <DataGridTextColumn Header="Ngày gửi" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Button Grid.Row="2" Content="Đóng" Width="100" Height="32"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Click="btnClose_Click"/>
    </Grid>
</Window>
