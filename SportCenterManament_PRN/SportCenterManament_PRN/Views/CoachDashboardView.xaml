<UserControl x:Class="SportCenterManament_PRN.Views.CoachDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Background="#F5F7FB" Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="COACH DASHBOARD"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <!-- THÔNG TIN CÁ NHÂN -->
        <GroupBox Grid.Row="1"
                  Header="THÔNG TIN CÁ NHÂN"
                  FontWeight="Bold"
                  Margin="0,0,0,15"
                  Padding="12">

            <StackPanel>

                <TextBlock x:Name="txtFullName"
                           FontSize="18"
                           Margin="0,5"/>

                <TextBlock x:Name="txtEmail"
                           Margin="0,5"/>

                <TextBlock x:Name="txtPhone"
                           Margin="0,5"/>

                <TextBlock x:Name="txtSpecialization"
                           Margin="0,5"/>

                <TextBlock x:Name="txtDisciplines"
                           Margin="0,5"/>

                <TextBlock x:Name="txtWorkSchedule"
                           Margin="0,5"/>

            </StackPanel>
        </GroupBox>

        <!-- LỚP HỌC CỦA TÔI -->
        <GroupBox Grid.Row="2"
                  Header="LỚP HỌC ĐƯỢC PHÂN CÔNG"
                  FontWeight="Bold"
                  Margin="0,0,0,15"
                  Padding="8">

            <DataGrid x:Name="dgClasses"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên lớp"
                                        Binding="{Binding ClassName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Bộ môn"
                                        Binding="{Binding DisciplineName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Sức chứa"
                                        Binding="{Binding Capacity}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Số buổi dạy"
                                        Binding="{Binding TotalSessions}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- LỊCH DẠY -->
        <GroupBox Grid.Row="3"
                  Header="LỊCH DẠY CỦA TÔI"
                  FontWeight="Bold"
                  Padding="8">

            <DataGrid x:Name="dgSchedule"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên lớp"
                                        Binding="{Binding ClassName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Bộ môn"
                                        Binding="{Binding DisciplineName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Ngày dạy"
                                        Binding="{Binding SessionDate}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Bắt đầu"
                                        Binding="{Binding StartTime}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Kết thúc"
                                        Binding="{Binding EndTime}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Phòng"
                                        Binding="{Binding RoomName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Đã đăng ký"
                                        Binding="{Binding BookedCount}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

    </Grid>
</UserControl>