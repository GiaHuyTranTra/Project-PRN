<UserControl x:Class="SportCenterManament_PRN.Views.CourseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ LỚP HỌC"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#1E40AF"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">

            <TextBox x:Name="txtSearch"
                     Width="200"
                     Height="32"
                     Padding="8,5"
                     ToolTip="Tìm theo tên lớp"/>

            <ComboBox x:Name="cbFilterDiscipline"
                      Width="150"
                      Height="32"
                      Margin="10,0,0,0"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <ComboBox x:Name="cbFilterStatus"
                      Width="145"
                      Height="32"
                      Margin="10,0,0,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Tất cả" Tag="All"/>
                <ComboBoxItem Content="Bản nháp" Tag="DRAFT"/>
                <ComboBoxItem Content="Đang hoạt động" Tag="OPEN"/>
                <ComboBoxItem Content="Đã đóng" Tag="CLOSED"/>
                <ComboBoxItem Content="Đã ẩn" Tag="ARCHIVED"/>
            </ComboBox>

            <Button Content="Tìm kiếm"
                    Width="90"
                    Margin="10,0,0,0"
                    Click="btnSearch_Click"/>

            <Button Content="Làm mới"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="btnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgCourses"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgCourses_SelectionChanged"
                  CanUserAddRows="False"
                  BorderBrush="#E5E7EB">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="55"/>

                <DataGridTextColumn Header="Tên lớp"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Bộ môn"
                                    Binding="{Binding DisciplineName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Sức chứa"
                                    Binding="{Binding Capacity}"
                                    Width="90"/>

                <DataGridTextColumn Header="Trạng thái"
                                    Binding="{Binding Status}"
                                    Width="110"/>

                <DataGridTextColumn Header="Mô tả"
                                    Binding="{Binding Description}"
                                    Width="2*"/>
                <DataGridTextColumn Header="Coach phụ trách"
                    Binding="{Binding CoachNames}"
                    Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="White"
                Padding="12"
                Margin="0,12,0,0"
                CornerRadius="6">

            <StackPanel>
                <TextBlock Text="THÔNG TIN LỚP HỌC"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Tên lớp"/>
                        <TextBox x:Name="txtName"
                                 Width="190"
                                 Height="30"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Bộ môn"/>
                        <ComboBox x:Name="cbDiscipline"
                                  Width="160"
                                  Height="30"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Sức chứa"/>
                        <TextBox x:Name="txtCapacity"
                                 Width="90"
                                 Height="30"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Mô tả"/>
                        <TextBox x:Name="txtDescription"
                                 Width="190"
                                 Height="30"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Thêm mới"
                            Width="100"
                            Margin="5"
                            Click="btnAdd_Click"/>

                    <Button Content="Cập nhật"
                            Width="100"
                            Margin="5"
                            Click="btnUpdate_Click"/>

                    <Button Content="Ẩn lớp"
                            Width="100"
                            Margin="5"
                            Click="btnHide_Click"/>

                    <Button Content="Hiện lại lớp"
            Width="110"
            Margin="5"
            Click="btnRestore_Click"/>

                    <Button Content="Phân công Coach"
                            Width="140"
                            Margin="5"
                            Click="btnAssign_Click"/>

                    <Button Content="Xóa form"
                            Width="90"
                            Margin="5"
                            Click="btnClear_Click"/>

                  
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
